<?xml version="1.0" encoding="UTF-8"?>
<phpunit colors="true" bootstrap="vendor/autoload.php">
    <php>
        <var name="driver_config_factory" value="Playwright\Mink\Tests\Config::getInstance"/>

        <!-- To run against another browser, copy this file to phpunit.xml and set: -->
        <!--<env name="PLAYWRIGHT_BROWSER" value="chromium"/>-->
        <!--<env name="PLAYWRIGHT_HEADLESS" value="1"/>-->
        <!--<env name="PLAYWRIGHT_CHANNEL" value="chromium"/>-->
        <!--<env name="PLAYWRIGHT_EXECUTABLE_PATH" value="/path/to/chromium"/>-->
        <!--<env name="PLAYWRIGHT_ARGS" value='["first argument", "second argument"]'/>-->
    </php>
    <testsuites>
        <testsuite name="Functional tests">
            <directory>vendor/mink/driver-testsuite/tests</directory>
        </testsuite>
        <testsuite name="Regression tests">
            <file>tests/Driver/AttachFileRelativePathTest.php</file>
        </testsuite>
    </testsuites>
    <filter>
        <whitelist>
            <directory>./src</directory>
        </whitelist>
    </filter>
    <listeners>
        <listener class="Symfony\Bridge\PhpUnit\SymfonyTestsListener"/>
    </listeners>
</phpunit>
